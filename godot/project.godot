; Engine configuration file.
; Edit through Godot when possible.
config_version=5

[application]

config/name="Narra"
run/main_scene="res://main.tscn"
config/version="0.1.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="Narra"
run/flush_stdout_on_print=true

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/engine.log"
file_logging/max_log_files=5
settings/crash_handler/message="Narra encountered a native engine failure. On the next launch, use Settings > Export Diagnostics and send the generated archive to support."
settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.039, 1)
